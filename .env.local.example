# Supabase public client env (already used by existing features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key

# Server-side admin key for API routes (set either one)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_SECRET_KEY=your_service_role_key

# APIMart GPT-Image-2 for /mirror
APIMART_API_KEY=your_apimart_api_key
# APIMART_API_BASE=https://api.apimart.ai/v1
# APIMART_IMAGE_RESOLUTION=1k
# APIMART_OFFICIAL_FALLBACK=false

# Xunhupay payment gateway
# Current default platform is the dpweixin backup gateway.
# Prefer channel-specific credentials.
# XUNHUPAY_WECHAT_APP_ID=your_wechat_app_id
# XUNHUPAY_WECHAT_APP_SECRET=your_wechat_app_secret
# XUNHUPAY_ALIPAY_APP_ID=your_alipay_app_id
# XUNHUPAY_ALIPAY_APP_SECRET=your_alipay_app_secret
# Optional API base overrides.
# XUNHUPAY_WECHAT_API_BASE=https://api.dpweixin.com
# XUNHUPAY_ALIPAY_API_BASE=https://api.dpweixin.com
# Shared fallback if both channels use one merchant.
# XUNHUPAY_APP_ID=your_shared_app_id
# XUNHUPAY_APP_SECRET=your_shared_app_secret
# XUNHUPAY_API_BASE=https://api.dpweixin.com

# Comma-separated Supabase user IDs allowed to access admin review and application management pages
ADMIN_USER_IDS=uuid1,uuid2

# ── Web Push (P0 daily 今日卡 reminder) ─────────────────────────────
# Generate: npx web-push generate-vapid-keys
# Set the same trio in Vercel Project → Settings → Environment Variables
# (Preview + Production). Never commit real private keys.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@wtfti.com
# Optional dedicated cron bearer (falls back to CRON_SECRET / letter secrets):
# PUSH_CRON_SECRET=
