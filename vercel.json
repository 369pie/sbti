{
  "crons": [
    {
      "path": "/api/soulti/soul-letter/dispatch",
      "schedule": "30 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "wtfti.com" }
      ],
      "destination": "https://www.wtfti.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "sbtinb.com" }
      ],
      "destination": "https://www.wtfti.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.sbtinb.com" }
      ],
      "destination": "https://www.wtfti.com/:path*",
      "permanent": true
    }
  ]
}
