{
  "crons": [
    {
      "path": "/api/soulti/soul-letter/dispatch",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/wtfti/letters/remind",
      "schedule": "45 14 * * *"
    },
    {
      "path": "/api/push/dispatch",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/email/daily-dispatch",
      "schedule": "15 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wtfti.com"
        }
      ],
      "destination": "https://www.wtfti.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sbtinb.com"
        }
      ],
      "destination": "https://www.wtfti.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sbtinb.com"
        }
      ],
      "destination": "https://www.wtfti.com/:path*",
      "permanent": true
    }
  ]
}
